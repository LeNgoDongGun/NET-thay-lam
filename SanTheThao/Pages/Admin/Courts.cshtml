@page
@model SanTheThao.Pages.Admin.CourtsModel
@{
    ViewData["Title"] = "Quản lý sân";
    Layout = "_Layout";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="fw-bold mb-0">🏟️ Quản lý sân</h4>
    <a asp-page="/Admin/Dashboard" class="btn btn-outline-secondary btn-sm">← Dashboard</a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2">@TempData["Message"]</div>
}

<!-- Form thêm sân -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <h6 class="fw-bold mb-3">➕ Thêm sân mới</h6>
        <form method="post" asp-page-handler="Add">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Môn thể thao</label>
                    <select asp-for="SportTypeId" class="form-select form-select-sm">
                        @foreach (var s in Model.SportTypes)
                        {
                            <option value="@s.Id">@s.Icon @s.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Tên sân</label>
                    <input asp-for="CourtName" class="form-control form-control-sm" placeholder="VD: Sân A3" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Giá / giờ (VNĐ)</label>
                    <input asp-for="PricePerHour" type="number" class="form-control form-control-sm" placeholder="200000" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Mô tả</label>
                    <input asp-for="Description" class="form-control form-control-sm" placeholder="Tuỳ chọn" />
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary btn-sm w-100">Thêm</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Danh sách sân -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Sân</th>
                        <th>Môn</th>
                        <th>Giá / giờ</th>
                        <th>Mô tả</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var court in Model.Courts)
                    {
                        <tr class="@(!court.IsActive ? "opacity-50" : "")">
                            <td class="ps-3 fw-semibold">@court.Name</td>
                            <td>@court.SportType.Icon @court.SportType.Name</td>
                            <td class="text-success fw-semibold">@court.PricePerHour.ToString("N0")</td>
                            <td class="text-muted">@court.Description</td>
                            <td>
                                @if (court.IsActive)
                                {
                                    <span class="badge bg-success">Đang mở</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Đã ẩn</span>
                                }
                            </td>
                            <td class="text-center">
                                <form method="post" asp-page-handler="Toggle" class="d-inline">
                                    <input type="hidden" name="id" value="@court.Id" />
                                    <button type="submit"
                                            class="btn btn-sm @(court.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(court.IsActive ? "Ẩn" : "Mở lại")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
