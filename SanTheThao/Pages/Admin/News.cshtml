@page
@model SanTheThao.Pages.Admin.NewsModel
@{
    ViewData["Title"] = "Quản lý tin tức";
    Layout = "_Layout";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="fw-bold mb-0">📰 Quản lý tin tức</h4>
    <a asp-page="/Admin/Dashboard" class="btn btn-outline-secondary btn-sm">← Dashboard</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2">@TempData["Success"]</div>
}

<!-- Form thêm bài viết -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <h6 class="fw-bold mb-3">✍️ Đăng bài viết mới</h6>
        <form method="post" asp-page-handler="Add">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Tiêu đề</label>
                    <input name="Title" class="form-control form-control-sm" placeholder="Tiêu đề bài viết" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Danh mục</label>
                    <select name="Category" class="form-select form-select-sm">
                        <option>Bóng đá</option>
                        <option>Cầu lông</option>
                        <option>Bóng chuyền</option>
                        <option>Bóng rổ</option>
                        <option>Pickleball</option>
                        <option>Tổng hợp</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Slug URL (tuỳ chọn)</label>
                    <input name="Slug" class="form-control form-control-sm" placeholder="tu-dong-tao" />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">Tóm tắt</label>
                    <input name="Summary" class="form-control form-control-sm"
                           placeholder="Mô tả ngắn hiển thị ở danh sách" required />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">Nội dung</label>
                    <textarea name="PostContent" class="form-control form-control-sm" rows="6"
                              placeholder="Nội dung đầy đủ của bài viết..." required></textarea>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary btn-sm">Đăng bài</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Danh sách bài viết -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Tiêu đề</th>
                        <th>Danh mục</th>
                        <th>Tác giả</th>
                        <th>Ngày đăng</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var post in Model.Posts)
                    {
                        <tr class="@(!post.IsPublished ? "opacity-50" : "")">
                            <td class="ps-3 fw-semibold" style="max-width:300px">@post.Title</td>
                            <td><span class="badge bg-primary">@post.Category</span></td>
                            <td>@post.Author.FullName</td>
                            <td>@post.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (post.IsPublished)
                                {
                                    <span class="badge bg-success">Đã đăng</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Đã ẩn</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex gap-1 justify-content-center">
                                    <a asp-page="/News/Detail" asp-route-slug="@post.Slug"
                                       class="btn btn-outline-primary btn-sm" target="_blank">👁</a>
                                    <form method="post" asp-page-handler="Toggle" class="d-inline">
                                        <input type="hidden" name="id" value="@post.Id" />
                                        <button type="submit"
                                                class="btn btn-sm @(post.IsPublished ? "btn-outline-secondary" : "btn-outline-success")">
                                            @(post.IsPublished ? "Ẩn" : "Hiện")
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="Delete" class="d-inline">
                                        <input type="hidden" name="id" value="@post.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm"
                                                onclick="return confirm('Xoá bài viết này?')">🗑</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
