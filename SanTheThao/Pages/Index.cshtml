@page
@model SanTheThao.Pages.IndexModel
@{
    ViewData["Title"] = "Trang chủ";
    Layout = "_Layout";
}

<!-- Hero -->
<div class="hero-section text-center mb-5">
    <div style="position:relative;z-index:1">
        <div style="font-size:3.5rem;margin-bottom:0.5rem">🏟️</div>
        <h1 class="fw-bold display-5 mb-2">Đặt Sân Thể Thao</h1>
        <p class="lead mb-4 opacity-75">Đặt sân nhanh chóng, tiện lợi — mọi lúc mọi nơi</p>
        <a asp-page="/Courts/Index" class="btn btn-light btn-lg fw-bold px-5">
            Đặt sân ngay →
        </a>
    </div>
</div>

<!-- Chọn môn -->
<div class="mb-5">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="fw-bold mb-0">🏅 Chọn môn thể thao</h5>
    </div>
    <div class="row g-3">
        @foreach (var sport in Model.SportTypes)
        {
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-page="/Courts/Index" asp-route-sportTypeId="@sport.Id"
                   class="card text-center text-decoration-none h-100 border-0 shadow-sm sport-card">
                    <div class="card-body py-4">
                        <div style="font-size:2.5rem">@sport.Icon</div>
                        <div class="fw-semibold mt-2 small">@sport.Name</div>
                        <div class="text-muted" style="font-size:0.75rem">@sport.Courts.Count sân</div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<!-- Top 3 sân hot -->
<div class="mb-5">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="fw-bold mb-0">🔥 Sân được đặt nhiều nhất</h5>
        <a asp-page="/Courts/Index" class="text-primary small fw-semibold text-decoration-none">Xem tất cả →</a>
    </div>
    <div class="row g-3">
        @foreach (var (court, count) in Model.TopCourts)
        {
            <div class="col-md-4">
                <div class="card border-0 shadow-sm court-card h-100">
                    <!-- Ảnh sân -->
                    <div
                        style="height:180px;overflow:hidden;border-radius:12px 12px 0 0;background:#e5e7eb;position:relative">
                        @if (!string.IsNullOrEmpty(court.ImageUrl))
                        {
                            <img src="@court.ImageUrl" alt="@court.Name"
                                 style="width:100%;height:100%;object-fit:cover;transition:transform 0.4s ease"
                                 class="court-img" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center h-100"
                                 style="background:linear-gradient(135deg,#e0e7ff,#c7d2fe)">
                                <span style="font-size:4rem">@court.SportType.Icon</span>
                            </div>
                        }
                        <!-- Badge lượt đặt -->
                        <div style="position:absolute;top:10px;right:10px">
                            <span class="badge"
                                  style="background:rgba(0,0,0,0.6);backdrop-filter:blur(4px);color:white;font-size:0.75rem">
                                🔥 @count lượt đặt
                            </span>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-primary small">@court.SportType.Name</span>
                        </div>
                        <h6 class="fw-bold mb-1">@court.Name</h6>
                        <div class="text-success fw-bold">@court.PricePerHour.ToString("N0") VNĐ / giờ</div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pt-0">
                        <a asp-page="/Courts/Detail" asp-route-id="@court.Id"
                           class="btn btn-primary w-100 fw-semibold btn-sm">
                            Xem lịch & Đặt sân
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Tin tức mới nhất -->
@if (Model.LatestNews.Any())
{
    <div class="mb-5">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="fw-bold mb-0">📰 Tin tức thể thao</h5>
            <a asp-page="/News/Index" class="text-primary small fw-semibold text-decoration-none">Xem tất cả →</a>
        </div>
        <div class="row g-3">
            @foreach (var post in Model.LatestNews)
            {
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm news-card h-100">
                        <!-- Ảnh tin -->
                        <div style="height:150px;overflow:hidden;border-radius:12px 12px 0 0;background:#f3f4f6">
                            @if (!string.IsNullOrEmpty(post.ThumbnailUrl))
                            {
                                <img src="@post.ThumbnailUrl" alt="@post.Title" style="width:100%;height:100%;object-fit:cover" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100"
                                     style="background:linear-gradient(135deg,#fef3c7,#fde68a)">
                                    <span style="font-size:3.5rem">📰</span>
                                </div>
                            }
                        </div>
                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-primary mb-2" style="width:fit-content">@post.Category</span>
                            <h6 class="fw-bold flex-grow-1">@post.Title</h6>
                            <p class="text-muted small mb-2">@post.Summary</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted" style="font-size:0.75rem">@post.CreatedAt.ToString("dd/MM/yyyy")</span>
                                <a asp-page="/News/Detail" asp-route-slug="@post.Slug"
                                   class="btn btn-outline-primary btn-sm">Đọc →</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Hướng dẫn -->
<div class="mb-2">
    <h5 class="fw-bold mb-3">📖 Cách đặt sân</h5>
    <div class="row g-3 text-center">
        @foreach (var (num, icon, title, desc) in new[]{
            ("1️⃣", "🏟️", "Chọn môn & sân", "Chọn môn thể thao và sân phù hợp"),
            ("2️⃣", "📅", "Chọn ngày & giờ", "Xem lịch trống và chọn khung giờ"),
            ("3️⃣", "✅", "Xác nhận & chơi", "Xác nhận và đến sân đúng giờ")
        })
        {
            <div class="col-md-4">
                <div class="card border-0 h-100 p-3" style="background:var(--light-gray)">
                    <div style="font-size:2rem">@num</div>
                    <div style="font-size:1.5rem">@icon</div>
                    <h6 class="fw-bold mt-2">@title</h6>
                    <p class="small text-muted mb-0">@desc</p>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .court-card:hover .court-img {
        transform: scale(1.06);
    }
</style>
