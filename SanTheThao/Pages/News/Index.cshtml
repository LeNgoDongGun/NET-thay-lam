@page
@model SanTheThao.Pages.News.IndexModel
@{
    ViewData["Title"] = "Tin tức thể thao";
    Layout = "_Layout";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h4 class="fw-bold mb-0">📰 Tin tức thể thao</h4>
</div>

<!-- Filter danh mục -->
<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-page="/News/Index"
       class="btn btn-sm @(Model.Category == null ? "btn-primary" : "btn-outline-secondary")">
        Tất cả
    </a>
    @foreach (var cat in Model.Categories)
    {
        <a asp-page="/News/Index" asp-route-category="@cat"
           class="btn btn-sm @(Model.Category == cat ? "btn-primary" : "btn-outline-secondary")">
            @cat
        </a>
    }
</div>

<!-- Danh sách bài viết -->
@if (!Model.Posts.Any())
{
    <div class="text-center py-5 text-muted">
        <div style="font-size:3rem">📰</div>
        <p class="mt-2">Chưa có bài viết nào</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var post in Model.Posts)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm news-card">
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-primary mb-2" style="width:fit-content">@post.Category</span>
                        <h6 class="fw-bold">@post.Title</h6>
                        <p class="text-muted small flex-grow-1">@post.Summary</p>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="text-muted" style="font-size:0.75rem">
                                @post.CreatedAt.ToString("dd/MM/yyyy")
                            </span>
                            <a asp-page="/News/Detail" asp-route-slug="@post.Slug"
                               class="btn btn-outline-primary btn-sm">Đọc tiếp →</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .news-card { transition: transform .15s, box-shadow .15s; }
    .news-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,0.12) !important; }
</style>
